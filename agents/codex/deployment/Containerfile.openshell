# Codex agent for OpenShell sandbox
#
# UBI-based image for running OpenAI Codex CLI inside an OpenShell sandbox.
#
# Build:
#   podman build --platform linux/amd64 -t codex-sandbox:latest -f Containerfile.openshell .

FROM registry.access.redhat.com/ubi10/ubi-minimal:10.1

ARG CODEX_VERSION=0.139.0
ARG USER_UID=1001
ARG USER_GID=0

# Install system dependencies and Node.js
RUN microdnf install -y --nodocs \
        git \
        curl \
        tar \
        iproute \
        nodejs \
        npm \
    && microdnf clean all \
    && rm -rf /var/cache/yum

# Create sandbox user (GID=0 for OpenShift arbitrary-UID compatibility)
RUN useradd -u ${USER_UID} -g ${USER_GID} -d /sandbox -m -s /bin/bash sandbox && \
    groupadd -f sandbox

# Create workspace directory
RUN mkdir -p /workspace && \
    chown -R ${USER_UID}:${USER_GID} /workspace && \
    chmod -R 775 /workspace

# Ensure sandbox home is group-writable for OpenShift random UID
RUN chown -R ${USER_UID}:${USER_GID} /sandbox && \
    chmod -R 775 /sandbox

# Install Codex CLI as root (Apache 2.0)
RUN npm install -g @openai/codex@${CODEX_VERSION}

# Verify installation
RUN codex --version

USER ${USER_UID}
WORKDIR /workspace
